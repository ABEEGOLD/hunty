{
  "extends": "@hunty/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/components": ["./components"],
      "@/components/*": ["./components/*"],
      "@/lib": ["./lib"],
      "@/lib/*": ["./lib/*"],
      "@/hooks": ["./hooks"],
      "@/hooks/*": ["./hooks/*"],
      "@/store": ["./store"],
      "@/store/*": ["./store/*"],
      "@/types": ["./types"],
      "@/types/*": ["./types/*"],
      "@shared/*": ["./shared/*"],
      "@hunty/types": ["../../packages/types/src/index.ts"],
      "@hunty/types/*": ["../../packages/types/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "mobile/**/*",
    "shared/**/*",
    "stories/**/*",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "**/__tests__/**/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
